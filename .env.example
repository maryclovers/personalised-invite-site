# Supabase — get these from your Supabase project settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin dashboard password — set to anything strong
ADMIN_PASSWORD=your-admin-password

# Event date in ISO format
EVENT_DATE=2026-06-18T19:00:00.000Z

# Anthropic API key — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# Resend API key — optional, leave blank to skip confirmation emails
RESEND_API_KEY=

# Base URL for generating invite links
NEXT_PUBLIC_BASE_URL=https://marycloversbday.vercel.app
